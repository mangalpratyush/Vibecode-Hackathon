# ---- PARAM environment ----

# Session signing secret (any long random string). The only required variable.
AUTH_SECRET=change-me-to-a-long-random-string

# Optional. Without it, bundles are kept in memory and lost on restart; the
# header says so rather than hiding it.
# MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_DB=param

# ---- PARAM Assistant ----
# Optional. Without a key the deterministic scrutiny engine, the rulebook and
# the limitation computation all still run in full; only the Assistant and the
# AI-assisted checks are disabled, and they say so. PARAM never fabricates an
# answer or a defect to fill the gap.
#
# AI_PROVIDER = gemini | anthropic | openai
AI_PROVIDER=gemini

# Key rotation: comma-separate two or more keys and callAI() moves to the next
# one immediately on a 429/503 instead of waiting out the window. Free-tier keys
# rate-limit easily, so more than one is worth having.
GEMINI_API_KEYS=key-one,key-two
# GEMINI_API_KEY=single-key-alternative

# Model. The library default (gemini-flash-lite-latest) mishandles Indian
# scripts badly enough to answer a Devanagari question with unrelated text, so
# PARAM pins the fuller flash model.
GEMINI_MODEL=gemini-flash-latest

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
