# ---- PARAM environment ----

# Session signing secret (any long random string). The only always-required one.
AUTH_SECRET=change-me-to-a-long-random-string

# Signs the integrity seal. Falls back to AUTH_SECRET when unset, which is fine
# locally. Set it separately in production so rotating one does not invalidate
# every seal ever issued.
# SEAL_SECRET=another-long-random-string

# Optional locally, REQUIRED in production.
#
# Locally, leaving it unset keeps filings in memory and the uploaded PDFs on
# disk under uploads/, which is fine and needs no database at all.
#
# On a serverless host it is required for two separate reasons. Filings kept in
# memory do not survive a cold start, which on serverless is most requests. And
# there is no writable disk, so the uploaded PDFs go into the GridFS bucket
# "uploads" in this same database instead. Repair, sealing and export all read
# those bytes back, so without this they have nothing to work from.
#
# A free MongoDB Atlas M0 cluster is enough. Run `npm run seed` once against it
# to create the collections and indexes.
# MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_DB=param

# ---- PARAM Assistant ----
# Optional. Without a key the deterministic scrutiny engine, the rulebook and
# the limitation computation all still run in full; only the Assistant and the
# AI-assisted checks are disabled, and they say so. PARAM never fabricates an
# answer or a defect to fill the gap.
#
# AI_PROVIDER = gemini | anthropic | openai
AI_PROVIDER=gemini

# Key rotation. callAI() moves to the next key immediately on a 429/503 instead
# of waiting out the window, so one key hitting a limit costs nothing. Add as
# many as you have; numbered vars or one comma-separated list both work.
GEMINI_API_KEY=key-one
GEMINI_API_KEY_2=key-two
GEMINI_API_KEY_3=key-three
# GEMINI_API_KEYS=key-one,key-two,key-three

# Model. Quota differs per model far more than capability does:
# gemini-flash-latest is a 20-requests-per-DAY free tier and will exhaust in a
# single testing session. flash-lite has a far larger allowance and answers
# Hindi, Tamil, Bengali and Marathi correctly.
GEMINI_MODEL=gemini-flash-lite-latest

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
