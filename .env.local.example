# ---- PARAM environment ----

# Session signing secret (any long random string). The only required variable.
AUTH_SECRET=change-me-to-a-long-random-string

# Optional. Without it, bundles are kept in memory and lost on restart; the
# header says so rather than hiding it.
# MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_DB=param

# ---- PARAM Assistant ----
# Optional. Without a key the deterministic scrutiny engine, the rulebook and
# the limitation computation all still run in full; only the Assistant and the
# AI-assisted checks are disabled, and they say so. PARAM never fabricates an
# answer or a defect to fill the gap.
#
# AI_PROVIDER = gemini | anthropic | openai
AI_PROVIDER=gemini

# Key rotation. callAI() moves to the next key immediately on a 429/503 instead
# of waiting out the window, so one key hitting a limit costs nothing. Add as
# many as you have; numbered vars or one comma-separated list both work.
GEMINI_API_KEY=key-one
GEMINI_API_KEY_2=key-two
GEMINI_API_KEY_3=key-three
# GEMINI_API_KEYS=key-one,key-two,key-three

# Model. Quota differs per model far more than capability does:
# gemini-flash-latest is a 20-requests-per-DAY free tier and will exhaust in a
# single testing session. flash-lite has a far larger allowance and answers
# Hindi, Tamil, Bengali and Marathi correctly. Check with:
#   node scripts/model-check.mjs
GEMINI_MODEL=gemini-flash-lite-latest

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
